@model DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Welcome, @Model.DoctorName</h2>
        <p class="text-muted mb-0">@Model.Specialization &bull; @Model.DepartmentName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Availability" class="btn btn-outline-primary"><i class="fa-solid fa-clock me-1"></i> Manage Slots</a>
        <a asp-action="Appointments" class="btn btn-primary"><i class="fa-solid fa-calendar-check me-1"></i> View Schedule</a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe; color:#0284c7;"><i class="fa-solid fa-calendar-day"></i></div>
            <div>
                <h3 class="fw-bold mb-0">@Model.TodayAppointmentsCount</h3>
                <small class="text-muted">Today's Visits</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef3c7; color:#d97706;"><i class="fa-solid fa-hourglass-half"></i></div>
            <div>
                <h3 class="fw-bold mb-0">@Model.UpcomingAppointmentsCount</h3>
                <small class="text-muted">Upcoming</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e6fffa; color:#0d9488;"><i class="fa-solid fa-hospital-user"></i></div>
            <div>
                <h3 class="fw-bold mb-0">@Model.TotalPatientsTreated</h3>
                <small class="text-muted">Patients Treated</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7; color:#15803d;"><i class="fa-solid fa-dollar-sign"></i></div>
            <div>
                <h3 class="fw-bold mb-0">$@Model.EstimatedEarnings.ToString("N2")</h3>
                <small class="text-muted">Earned Fees</small>
            </div>
        </div>
    </div>
</div>

<!-- Today's Schedule -->
<div class="card-custom p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">Today's Patient Schedule</h5>
        <span class="badge bg-light text-primary border">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</span>
    </div>

    @if (!Model.TodayAppointments.Any())
    {
        <div class="text-center py-5">
            <i class="fa-regular fa-calendar-check text-muted fs-1 mb-2"></i>
            <p class="text-muted">No appointments scheduled for today.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Time</th>
                        <th>Patient</th>
                        <th>Contact</th>
                        <th>Reason for Consultation</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var apt in Model.TodayAppointments)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@apt.StartTime.ToString(@"hh\:mm") - @apt.EndTime.ToString(@"hh\:mm")</td>
                            <td>
                                <div class="fw-bold text-dark">@apt.PatientName</div>
                                <small class="text-muted">@apt.PatientGender &bull; @apt.PatientBloodGroup</small>
                            </td>
                            <td>@apt.PatientPhone</td>
                            <td class="text-truncate" style="max-width: 250px;">@apt.Reason</td>
                            <td>
                                <span class="badge-pill @(apt.Status == "Confirmed" ? "badge-status-confirmed" : apt.Status == "Completed" ? "badge-status-completed" : "badge-status-pending")">
                                    @apt.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    @if (apt.Status == "Pending")
                                    {
                                        <form asp-action="AcceptAppointment" asp-route-id="@apt.AppointmentId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success" title="Accept"><i class="fa-solid fa-check"></i> Accept</button>
                                        </form>
                                        <form asp-action="RejectAppointment" asp-route-id="@apt.AppointmentId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject"><i class="fa-solid fa-xmark"></i></button>
                                        </form>
                                    }
                                    else if (apt.Status == "Confirmed")
                                    {
                                        <a asp-action="AddMedicalRecord" asp-route-appointmentId="@apt.AppointmentId" asp-route-patientId="@apt.PatientId" class="btn btn-sm btn-primary">
                                            <i class="fa-solid fa-file-medical me-1"></i> Add Rx / Complete
                                        </a>
                                    }
                                    else if (apt.Status == "Completed")
                                    {
                                        <a asp-action="PatientHistory" asp-route-patientId="@apt.PatientId" class="btn btn-sm btn-outline-secondary">
                                            <i class="fa-solid fa-clock-rotate-left me-1"></i> History
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
