@model DoctorProfileViewModel
@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="card-custom p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-0">Doctor Profile</h3>
                    <small class="text-muted">Manage your clinical credentials and consultation fee</small>
                </div>
            </div>

            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DoctorId" />
                <input type="hidden" asp-for="DepartmentId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold small">Full Name</label>
                        <input asp-for="FullName" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small">Email Address</label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small">Contact Phone</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Assigned Department</label>
                        <input value="@Model.DepartmentName" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Specialization" class="form-label fw-semibold small">Specialization *</label>
                        <input asp-for="Specialization" class="form-control" />
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Qualification" class="form-label fw-semibold small">Qualifications *</label>
                        <input asp-for="Qualification" class="form-control" />
                        <span asp-validation-for="Qualification" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExperienceYears" class="form-label fw-semibold small">Years of Practice</label>
                        <input asp-for="ExperienceYears" type="number" class="form-control" />
                        <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConsultationFee" class="form-label fw-semibold small">Consultation Fee ($) *</label>
                        <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Biography" class="form-label fw-semibold small">Professional Summary</label>
                        <textarea asp-for="Biography" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsAvailable" class="form-check-input" />
                            <label asp-for="IsAvailable" class="form-check-label fw-semibold small">Accepting Patient Appointments</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
