@{
    ViewData["Title"] = "About MedConnect";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card-custom p-5">
                <span class="badge bg-primary-light text-primary px-3 py-2 rounded-pill fw-bold mb-3" style="background:#e6fffa; width:fit-content;">
                    Enterprise Healthcare Platform
                </span>
                <h1 class="fw-bold mb-4">About MedConnect</h1>
                <p class="lead text-muted">
                    MedConnect is an enterprise-grade full-stack healthcare appointment and clinical record management platform built with ASP.NET Core, Entity Framework Core, SQL Server, and modern web interfaces.
                </p>
                <hr class="my-4" />
                <h4 class="fw-bold mb-3">Core Architectural Capabilities</h4>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-primary"><i class="fa-solid fa-calendar-check me-2"></i> Conflict-Free Booking Engine</h6>
                            <p class="text-muted small mb-0">Enforces business rules preventing overlapping doctor slots, patient double-booking, and past-date reservations.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-primary"><i class="fa-solid fa-shield-halved me-2"></i> Role-Based Access Control</h6>
                            <p class="text-muted small mb-0">Separate authentication and authorization pipelines for Administrators, Doctors, and Patients with both Cookie and JWT Bearer support.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-primary"><i class="fa-solid fa-notes-medical me-2"></i> Clinical Record Tracking</h6>
                            <p class="text-muted small mb-0">Structured medical notes containing diagnoses, observed symptoms, and prescription medications linked 1-to-1 with completed appointments.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-primary"><i class="fa-solid fa-code me-2"></i> RESTful OpenAPI / Swagger</h6>
                            <p class="text-muted small mb-0">Fully documented and tested Web APIs ready for mobile app, React, or third-party enterprise healthcare integration.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
