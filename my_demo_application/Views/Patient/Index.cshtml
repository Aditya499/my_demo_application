@model PatientDashboardViewModel
@{
    ViewData["Title"] = "Patient Portal";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Hello, @Model.FullName</h2>
        <p class="text-muted mb-0">Manage your appointments, health records, and clinical consultations.</p>
    </div>
    <a asp-action="FindDoctor" class="btn btn-primary"><i class="fa-solid fa-calendar-plus me-1"></i> Book New Appointment</a>
</div>

<!-- Next Upcoming Appointment Banner -->
@if (Model.NextAppointment != null)
{
    <div class="card-custom p-4 mb-4" style="background: linear-gradient(135deg, #f0fdfa, #e0f2fe); border-color: #99f6e4;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-primary px-3 py-1 mb-2">Next Upcoming Consultation</span>
                <h4 class="fw-bold text-dark mb-1">Dr. @Model.NextAppointment.DoctorName</h4>
                <p class="text-muted mb-0">
                    <i class="fa-solid fa-stethoscope me-1 text-primary"></i> @Model.NextAppointment.DepartmentName (@Model.NextAppointment.Specialization)
                </p>
                <p class="text-dark fw-semibold mt-1 mb-0">
                    <i class="fa-solid fa-calendar-day me-1 text-primary"></i> @Model.NextAppointment.AppointmentDate.ToString("dddd, MMMM dd, yyyy") at @Model.NextAppointment.StartTime.ToString(@"hh\:mm")
                </p>
            </div>
            <div>
                <a asp-action="MyAppointments" class="btn btn-outline-primary">View Details</a>
            </div>
        </div>
    </div>
}

<!-- Stats Overview -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe; color:#0284c7;"><i class="fa-solid fa-clock"></i></div>
            <div>
                <h3 class="fw-bold mb-0">@Model.UpcomingAppointmentsCount</h3>
                <small class="text-muted">Upcoming Visits</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#dcfce7; color:#15803d;"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <h3 class="fw-bold mb-0">@Model.CompletedAppointmentsCount</h3>
                <small class="text-muted">Completed Consultations</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon" style="background:#f3e8ff; color:#7c3aed;"><i class="fa-solid fa-file-prescription"></i></div>
            <div>
                <h3 class="fw-bold mb-0">@Model.TotalPrescriptionsCount</h3>
                <small class="text-muted">Prescriptions on File</small>
            </div>
        </div>
    </div>
</div>

<!-- Recent Consultations Table -->
<div class="card-custom p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold text-dark mb-0">Recent Consultations</h5>
        <a asp-action="MyAppointments" class="btn btn-sm btn-outline-primary">View All</a>
    </div>

    @if (!Model.RecentAppointments.Any())
    {
        <div class="text-center py-4">
            <p class="text-muted mb-0">No consultations on record yet. Search our verified specialists to book your first visit!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Doctor</th>
                        <th>Department</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th class="text-end">Record</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var apt in Model.RecentAppointments)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@apt.DoctorName</td>
                            <td><span class="badge bg-light text-dark border">@apt.DepartmentName</span></td>
                            <td>@apt.AppointmentDate.ToString("MMM dd, yyyy") @@ @apt.StartTime.ToString(@"hh\:mm")</td>
                            <td>
                                <span class="badge-pill @(apt.Status == "Confirmed" ? "badge-status-confirmed" : apt.Status == "Completed" ? "badge-status-completed" : apt.Status == "Cancelled" ? "badge-status-cancelled" : "badge-status-pending")">
                                    @apt.Status
                                </span>
                            </td>
                            <td class="text-end">
                                @if (apt.MedicalRecordId.HasValue)
                                {
                                    <a asp-action="MyMedicalRecords" class="btn btn-sm btn-outline-success">
                                        <i class="fa-solid fa-prescription me-1"></i> View Rx
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
