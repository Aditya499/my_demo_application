@model IEnumerable<DepartmentViewModel>
@{
    ViewData["Title"] = "Manage Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Hospital Departments</h2>
        <p class="text-muted mb-0">Configure specialties and view assigned doctors.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createDeptModal">
        <i class="fa-solid fa-plus me-1"></i> Add Department
    </button>
</div>

<div class="row g-4">
    @foreach (var dept in Model)
    {
        <div class="col-md-4">
            <div class="card-custom p-4 h-100 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 p-3 bg-primary-light text-primary fs-4">
                        <i class="fa-solid @(string.IsNullOrEmpty(dept.Icon) ? "fa-stethoscope" : dept.Icon)"></i>
                    </div>
                    <span class="badge bg-light text-dark border">@dept.DoctorCount Doctor@(dept.DoctorCount == 1 ? "" : "s")</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">@dept.DepartmentName</h5>
                <p class="text-muted small mb-3">@dept.Description</p>
                <div class="mt-auto pt-3 border-top d-flex justify-content-end gap-2">
                    <form asp-action="DeleteDepartment" asp-route-id="@dept.DepartmentId" method="post" onsubmit="return confirm('Are you sure you want to delete this department?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" @(dept.DoctorCount > 0 ? "disabled" : "") title="Delete Department">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Create Department Modal -->
<div class="modal fade" id="createDeptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content card-custom">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">Add Clinical Department</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateDepartment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Department Name *</label>
                        <input type="text" name="DepartmentName" class="form-control" required placeholder="e.g. Oncology" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Clinical focus and service offerings..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">FontAwesome Icon Class</label>
                        <input type="text" name="Icon" class="form-control" placeholder="e.g. fa-ribbon, fa-stethoscope, fa-lungs" value="fa-stethoscope" />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Department</button>
                </div>
            </form>
        </div>
    </div>
</div>
